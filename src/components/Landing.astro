---
/**
 * The website, after the flight. It sits directly below `<Experience />` in the same page: when
 * the last chapter has scrolled through (the experience is finished) this content scrolls up
 * over the fixed canvas like a curtain, the nav comes back, and the engine stops rendering
 * behind it. Every word is the site's own copy (story/copy.ts); only the section headings and
 * the replay button are new.
 */
import { DOWNLOAD, FAQ, HOME_CHAPTERS, PRICING } from '../story/copy';
import { href } from '../lib/href';

const closing = HOME_CHAPTERS[HOME_CHAPTERS.length - 1]!;
---

<section class="landing" id="landing-page" aria-label="Email Pilots">
  <div class="landing__inner">
    <header class="landing__hero" data-reveal>
      <p class="page__kicker">{DOWNLOAD.kicker}</p>
      <h2>{DOWNLOAD.title}</h2>
      <p class="page__lede">{DOWNLOAD.body}</p>
      <div class="btn-row">
        <a
          class="btn btn--primary"
          data-magnetic
          href={DOWNLOAD.cta.href}
          aria-disabled={DOWNLOAD.cta.pending ? 'true' : undefined}
          title={DOWNLOAD.cta.pending ? 'Release link coming with launch' : undefined}
        >
          {DOWNLOAD.cta.label}
        </a>
        <a class="btn btn--ghost" href={href('/features')}>Read the flight manual</a>
        <button class="btn btn--ghost" type="button" data-replay>Replay the flight</button>
      </div>
      <p class="pricing-card__note">{DOWNLOAD.requirements}</p>
    </header>

    <section class="landing__section" aria-labelledby="landing-flight">
      <p class="page__kicker">The flight, in brief</p>
      <h2 id="landing-flight">Ten stops, one send.</h2>
      <div class="landing__grid">
        {
          HOME_CHAPTERS.map((c) => (
            <article class="landing__card" data-reveal>
              <p class="landing__card-kicker">{c.kicker}</p>
              <h3>{c.title}</h3>
              <ul>
                {c.chips.map((chip) => (
                  <li>{chip}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="landing__section landing__pricing" aria-labelledby="landing-pricing">
      <p class="page__kicker">{PRICING.kicker}</p>
      <h2 id="landing-pricing">{PRICING.title}</h2>
      <div class="pricing-card" data-reveal>
        <div class="pricing-card__price">
          {PRICING.price}<small>{PRICING.period}</small>
        </div>
        <ul>
          {PRICING.bullets.map((b) => <li>{b}</li>)}
        </ul>
        <a class="btn btn--primary" data-magnetic href={href(PRICING.cta.href)}>{PRICING.cta.label}</a>
        <p class="pricing-card__note" style="margin-top:1.25rem">{PRICING.note}</p>
      </div>
    </section>

    <section class="landing__section faq" aria-labelledby="landing-faq" data-reveal>
      <h2 id="landing-faq" style="font-family:var(--font-display);font-weight:400">Questions, answered.</h2>
      {
        FAQ.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>

    <section class="landing__closing" data-reveal>
      <h2>{closing.title}</h2>
      <p class="page__lede">{closing.body}</p>
      <div class="btn-row">
        <a class="btn btn--primary" data-magnetic href={href('/download')}>Download for Windows — 7-day free trial</a>
        <a class="btn btn--ghost" href={href('/pricing')}>See pricing</a>
      </div>
    </section>
  </div>
</section>
