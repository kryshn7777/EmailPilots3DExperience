---
/**
 * The website, after the flight: one block over the last frame (the recipient's open inbox), and
 * nothing else. It sits directly below `<Experience />` in the same page: when the last chapter has
 * scrolled through, this block scrolls up over the fixed canvas, the nav comes back, and the engine
 * stops rendering behind it (the canvas keeps its last frame, which the block's glass lets through).
 * Every word comes from story/copy.ts (`INTRO`, `DOWNLOAD`, `SITE`): the flight has already said the
 * rest, so there is no feature list, no FAQ and no pricing here.
 */
import { DOWNLOAD, INTRO, SITE } from '../story/copy';
---

<section class="landing" id="landing-page" aria-labelledby="landing-title">
  <div class="landing__block" data-reveal>
    <div class="landing__kicker">{INTRO.kicker}</div>
    <h2 id="landing-title">{INTRO.title}</h2>
    <p class="landing__body">{INTRO.body}</p>
    <a class="btn btn--brand landing__cta" data-magnetic href={DOWNLOAD.cta.href}>
      <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 3v10M5.5 8.5 10 13l4.5-4.5M4 17h12" />
      </svg>
      {DOWNLOAD.cta.label}
    </a>
    <div class="landing__links">
      <a href={SITE.home} target="_blank" rel="noopener">{SITE.label}&nbsp;↗</a>
      <span aria-hidden="true">·</span>
      <button type="button" data-replay>{INTRO.replay}</button>
    </div>
    <ul class="landing__tags">
      {
        INTRO.tags.map((tag) => (
          <li>{tag}</li>
        ))
      }
    </ul>
  </div>
</section>
